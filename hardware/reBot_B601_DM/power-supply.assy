# Power supply enclosure of the reBot Arm B601 DM.
#
# This file follows the "Power Supply Assembly" section of ./readme.md step by
# step. Each step of the readme is one container node below, named after the
# step number used there, so that the readme and the model stay comparable.
#
# STATUS
#   * The printed enclosure parts and the fasteners that hold them are placed.
#   * The purchased contents (the LRS-350-24 supply, the XT60E connector, the
#     3-in-1 IEC socket, the AC wiring and the M3 hex nuts) are NOT placed:
#     PartCAD has no way to declare a catalog part that has no CAD model yet.
#     See PARTCAD.md, "Blockers", item 1.
#   * Every 'location' below is the identity location. The relative placement of
#     the parts still has to be measured off the CAD model.
#     See PARTCAD.md, "Next steps", item 3.
#
# NOTE ON REPEATED PARTS
#   PartCAD has no 'count' field in ASSY: a part appears in the BOM once per
#   link. Repeated fasteners are therefore emitted with a Jinja loop, which is
#   what keeps the quantity of the BOM correct and the file short.

links:
  # ---------------------------------------------------------------------------
  # 1. Front cover assembly
  # ---------------------------------------------------------------------------
  - name: front-cover
    # 1-1  Prepare the parts and printed components required for front shell
    #      assembly. Check that all parts are complete.
    location: [[0, 0, 0], [0, 0, 1], 0]
    links:
      # 1-2  Wiring sequence instructions for each part; assemble according to
      #      the wiring sequence. Connect strictly according to the wiring
      #      sequence diagram.
      # TODO(data): the wiring sequence itself is only available as the images
      # Assembly_Steps/powerstep_images/1-2(1..3).png.

      - part: printed/psu-front-cover
        name: front-cover-shell
        location: [[0, 0, 0], [0, 0, 1], 0]

      # 1-3  Install the XT60 connector.
      #      Secured with M3x8 304 countersunk screws and M3x2.5 hex nuts.
      # TODO(blocked): the XT60E female + lug pigtail has no CAD model.
      # TODO(blocked): the M3x2.5 hex nuts (x2) have no CAD model.
      {% for i in range(2) %}
      - part: purchased/screw-m3x8-countersunk
        name: xt60-screw-{{ i + 1 }}
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% endfor %}

      # 1-4  Install the 3-in-1 IEC socket.
      #      Secured with M3x8 304 pan head screws.
      # TODO(blocked): the 3-in-1 IEC inlet socket has no CAD model.
      {% for i in range(2) %}
      - part: purchased/screw-m3x8-pan
        name: iec-socket-screw-{{ i + 1 }}
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% endfor %}

      # 1-5  Internal wiring of the front shell. Check the connections against
      #      the wiring sequence diagram.
      # TODO(blocked): the 1.5mm^2 red/blue/yellow AC wiring (x3) has no CAD
      # model.

      # 1-6  Secure both sides of the front shell and the power supply with
      #      M4x6 304 countersunk screws (x2).
      # TODO(blocked): the MeanWell LRS-350-24 power supply has no CAD model.
      {% for i in range(2) %}
      - part: purchased/screw-m4x6-countersunk
        name: front-cover-screw-{{ i + 1 }}
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% endfor %}

      # 1-7  Install the sliding cover. Push it in from the bottom of the power
      #      supply.
      - part: printed/psu-front-cover-slider
        name: front-cover-slider
        location: [[0, 0, 0], [0, 0, 1], 0]

      # 1-8  Secure the sliding cover with M4x6 304 countersunk screws (x2).
      {% for i in range(2) %}
      - part: purchased/screw-m4x6-countersunk
        name: slider-screw-{{ i + 1 }}
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% endfor %}

  # ---------------------------------------------------------------------------
  # 2. Rear shell assembly
  # ---------------------------------------------------------------------------
  - name: rear-cover
    # 2-1  Prepare the parts and printed components required for rear shell
    #      assembly. Check accessories for completeness.
    location: [[0, 0, 0], [0, 0, 1], 0]
    links:
      # 2-2  Assemble the rear shell with the power supply. Align the position.
      - part: printed/psu-rear-cover
        name: rear-cover-shell
        location: [[0, 0, 0], [0, 0, 1], 0]

      # 2-3  Secure both sides of the rear shell and the power supply with
      #      M4x6 304 countersunk screws (x2).
      {% for i in range(2) %}
      - part: purchased/screw-m4x6-countersunk
        name: rear-cover-screw-{{ i + 1 }}
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% endfor %}

  # 3. Overall completion: check that all screws are tightened.

# Power supply enclosure of the reBot Arm B601 DM.
#
# This file follows the "Power Supply Assembly" section of ./readme.md step by
# step. Each readme step is one node here, carrying the readme's own wording in
# 'description'.
#
# The instruction book is generated from this file:
#
#   pc render -t pdf -a power-supply     # or -t html
#
# STATUS
#   * The printed enclosure parts, the fasteners that hold them, the supply
#     itself and the XT60E output connector are placed - the last two from
#     //pub/robotics/rebot/devarm/third_party, this repository's package of
#     envelopes for other people's products.
#   * The 3-in-1 IEC socket, the AC wiring and the M3 hex nuts are not: they have
#     no envelope yet. See PARTCAD.md.
#   * Every node is placed with 'location', so none of them can carry the 'how'
#     section - the torque, the push force, the stage, what to hold each part
#     by - which ASSY accepts only inside 'connect'/'connectPorts'. Interfaces
#     and ports have to be declared on the parts first. See PARTCAD.md,
#     "Next steps", item 2.
#   * Every 'location' is the identity location. The relative placement of the
#     parts still has to be measured off the CAD model.
#
# NOTE ON REPEATED PARTS
#   ASSY has no quantity field, by design: a part appears in the bill of
#   materials once per link. Repeated fasteners are emitted with a Jinja2 loop,
#   which is how a file stays short without the model losing track of the
#   individual instances.

links:
  # ---------------------------------------------------------------------------
  # 1. Front cover assembly
  # ---------------------------------------------------------------------------
  - name: front-cover
    description: >-
      Step 1-1. Prepare the parts and printed components required for front
      shell assembly. Check that all parts are complete.
    location: [[0, 0, 0], [0, 0, 1], 0]
    links:
      - part: printed/psu-front-cover
        name: front-cover-shell
        description: >-
          Step 1-2. Wiring sequence instructions for each part; assemble
          according to the wiring sequence. Connect strictly according to the
          wiring sequence diagram
          (Assembly_Steps/powerstep_images/1-2(1..3).png).
        location: [[0, 0, 0], [0, 0, 1], 0]

      - part: purchased/connector-xt60e
        name: xt60-connector
        description: >-
          Step 1-3. The XT60E output connector, through the front cover.
        location: [[0, 0, 0], [0, 0, 1], 0]

      # TODO(blocked): the M3x2.5 hex nuts (x2) have no CAD model.
      {% for i in range(2) %}
      - part: purchased/screw-m3x8-countersunk
        name: xt60-screw-{{ i + 1 }}
        description: >-
          Step 1-3. Install the XT60 connector, secured with 304 stainless steel
          Phillips countersunk head screws M3x8 and M3x2.5 hex nuts.
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% endfor %}

      # TODO(blocked): the 3-in-1 IEC inlet socket has no CAD model.
      {% for i in range(2) %}
      - part: purchased/screw-m3x8-pan
        name: iec-socket-screw-{{ i + 1 }}
        description: >-
          Step 1-4. Install the 3-in-1 IEC socket, secured with 304 stainless
          steel Phillips pan head screws M3x8.
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% endfor %}

      # Step 1-5. Internal wiring of the front shell. Check the connections
      # against the wiring sequence diagram.
      # TODO(blocked): the 1.5mm^2 red/blue/yellow AC wiring (x3) has no CAD
      # model, so this step has no node of its own to describe.

      - part: purchased/psu-lrs-350-24
        name: power-supply
        description: >-
          Step 1-6. The power supply itself, which both covers are screwed to.
        location: [[0, 0, 0], [0, 0, 1], 0]

      {% for i in range(2) %}
      - part: purchased/screw-m4x6-countersunk
        name: front-cover-screw-{{ i + 1 }}
        description: >-
          Step 1-6. Secure both sides of the front shell and the power supply
          with M4x6 304 stainless steel Phillips countersunk head screws.
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% endfor %}

      - part: printed/psu-front-cover-slider
        name: front-cover-slider
        description: >-
          Step 1-7. Install the sliding cover, pushing it in from the bottom of
          the power supply.
        location: [[0, 0, 0], [0, 0, 1], 0]

      {% for i in range(2) %}
      - part: purchased/screw-m4x6-countersunk
        name: slider-screw-{{ i + 1 }}
        description: >-
          Step 1-8. Secure the sliding cover with M4x6 304 stainless steel
          Phillips countersunk head screws.
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% endfor %}

  # ---------------------------------------------------------------------------
  # 2. Rear shell assembly
  # ---------------------------------------------------------------------------
  - name: rear-cover
    description: >-
      Step 2-1. Prepare the parts and printed components required for rear shell
      assembly. Check accessories for completeness.
    location: [[0, 0, 0], [0, 0, 1], 0]
    links:
      - part: printed/psu-rear-cover
        name: rear-cover-shell
        description: >-
          Step 2-2. Assemble the rear shell with the power supply, aligning the
          position.
        location: [[0, 0, 0], [0, 0, 1], 0]

      {% for i in range(2) %}
      - part: purchased/screw-m4x6-countersunk
        name: rear-cover-screw-{{ i + 1 }}
        description: >-
          Step 2-3. Secure both sides of the rear shell and the power supply
          with M4x6 304 stainless steel Phillips countersunk head screws.
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% endfor %}

  # Step 3. Overall completion: check that all screws are tightened.

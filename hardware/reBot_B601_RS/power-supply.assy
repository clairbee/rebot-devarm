# Power supply enclosure of the reBot Arm B601 RS.
#
# Follows the "Power Supply Assembly" section of ./README.md, one node per step,
# carrying the README's own wording in 'description'. The RS enclosure is
# assembled exactly like the DM one, around the 48V LRS-600-48 supply instead of
# the 24V LRS-350-24.
#
#   pc render -t pdf -a power-supply     # the instruction book
#
# STATUS: the printed shells, their fasteners, the supply itself and the XT60E
# connector are placed; the 3-in-1 IEC socket, the AC wiring and the M3 hex nuts
# have no envelope yet and are not. Locations are identity locations, and nothing
# here can carry a 'how' section until the parts declare interfaces.
# See ../../PARTCAD.md.

links:
  # ---------------------------------------------------------------------------
  # 1. Front shell assembly
  # ---------------------------------------------------------------------------
  - name: front-cover
    description: >-
      Step 1-1. Prepare the parts and printed components required for front
      shell assembly. Check that all parts are present.
    location: [[0, 0, 0], [0, 0, 1], 0]
    links:
      - part: printed/psu-front-cover
        name: front-cover-shell
        description: >-
          Step 1-2. Wiring sequence instructions for each part; assemble
          according to the wiring sequence diagram
          (Assembly_Steps/powerstep_images/1-2(1..3).png).
        location: [[0, 0, 0], [0, 0, 1], 0]

      - part: purchased/connector-xt60e
        name: xt60-connector
        description: Step 1-3. The XT60E output connector, through the front shell.
        location: [[0, 0, 0], [0, 0, 1], 0]

      # TODO(blocked): the M3x2.5 hex nuts (x2) have no envelope yet.
      {% for i in range(2) %}
      - part: purchased/screw-m3x8-countersunk
        name: xt60-screw-{{ i + 1 }}
        description: >-
          Step 1-3. Install the XT60 connector, secured with M3x8 304
          countersunk cross-head screws and M3x2.5 hex nuts.
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% endfor %}

      # TODO(blocked): 3-in-1 IEC inlet socket - no CAD model.
      {% for i in range(2) %}
      - part: purchased/screw-m3x8-pan
        name: iec-socket-screw-{{ i + 1 }}
        description: >-
          Step 1-4. Install the 3-in-1 IEC socket, secured with M3x8 304 pan
          head cross-head screws.
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% endfor %}

      # Step 1-5. Internal wiring of the front shell; check against the diagram.
      # TODO(blocked): 1.5mm^2 AC wiring (x3) - no CAD model.

      - part: purchased/psu-lrs-600-48
        name: power-supply
        description: Step 1-6. The power supply itself, which both shells are screwed to.
        location: [[0, 0, 0], [0, 0, 1], 0]

      {% for i in range(4) %}
      - part: purchased/screw-m4x6-countersunk
        name: front-cover-screw-{{ i + 1 }}
        description: >-
          Step 1-6. Secure the front shell to both sides of the power supply
          with 4x M4x6 304 countersunk cross-head screws.
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% endfor %}

      - part: printed/psu-front-cover-slider
        name: front-cover-slider
        description: >-
          Step 1-7. Install the sliding cover, pushing it in from the bottom of
          the power supply.
        location: [[0, 0, 0], [0, 0, 1], 0]

      {% for i in range(2) %}
      - part: purchased/screw-m4x6-countersunk
        name: slider-screw-{{ i + 1 }}
        description: >-
          Step 1-8. Secure the sliding cover with 2x M4x6 304 countersunk
          cross-head screws.
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% endfor %}

  # ---------------------------------------------------------------------------
  # 2. Rear shell assembly
  # ---------------------------------------------------------------------------
  - name: rear-cover
    description: >-
      Step 2-1. Prepare the parts and printed components required for rear shell
      assembly. Check that all accessories are complete.
    location: [[0, 0, 0], [0, 0, 1], 0]
    links:
      - part: printed/psu-rear-cover
        name: rear-cover-shell
        description: >-
          Step 2-2. Assemble the rear shell with the power supply, aligning the
          position.
        location: [[0, 0, 0], [0, 0, 1], 0]

      # NOTE: README.md's consumables BOM lists 10 M4x6 screws in total, while
      # the steps use 4 (1-6) + 2 (1-8) + 2 (2-3) = 8.
      # TODO(data): confirm the count with the vendor.
      {% for i in range(2) %}
      - part: purchased/screw-m4x6-countersunk
        name: rear-cover-screw-{{ i + 1 }}
        description: >-
          Step 2-3. Secure both sides of the rear shell and the power supply
          with M4x6 304 countersunk cross-head screws.
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% endfor %}

# reBot Arm B601 RS.
#
# The DM variant's ./../reBot_B601_DM/arm.assy, for the RobStride arm. Its
# purpose today is the same: every part of ./README.md is placed here as many
# times as that document says it is used, so that the bill of materials is
# aggregated from the assembly rather than typed into a markdown table.
#
# Check it with:
#
#   pc bom -P //pub/robotics/rebot/devarm/b601-rs arm
#   pc render -t readme -P //pub/robotics/rebot/devarm/b601-rs
#
# STATUS
#   * Every printed and machined part of the arm is placed with the README's
#     quantity, and so is every purchased part that has an envelope in
#     //pub/robotics/rebot/devarm/third_party: the seven actuators, the four
#     bearings, the rail, its two carriages and the silicone pad.
#   * Fasteners are NOT placed, and neither is the gear, the CAN-USB board or
#     the XT30 power separation board. The README gives arm-wide minimums for
#     the fasteners ("80+"), never a per-joint count; the released STEP file
#     does, and counting them there is the next step (see ../../PARTCAD.md).
#   * Every 'location' is the identity location, so this assembly is not
#     geometrically correct yet - it is a bill of materials with a structure.
#     The placements are to be recovered from the released CAD and then replaced
#     by interface/port matings, which is also what will let each step carry a
#     'how' (ASSY accepts one only inside 'connect'/'connectPorts').
#   * The grouping below follows the DM variant's and the part names. It has to
#     be confirmed against the CAD model.
#
# The RS arm is a different machine from the DM one below the part names: it has
# its own links 3, 4-5 and wrist connectors, the joint discs that cover the
# screws, and the RS06 extensions. Nothing here is copied from the DM file
# without a part of this package behind it.

links:
  # ---------------------------------------------------------------------------
  # Base
  # ---------------------------------------------------------------------------
  - name: base
    description: >-
      The base - the plate the arm stands on, the base link, the motor 1 bearing mount, and link 1.
    location: [[0, 0, 0], [0, 0, 1], 0]
    links:
      - part: printed/base-plate
        location: [[0, 0, 0], [0, 0, 1], 0]
      - part: printed/base-link
        location: [[0, 0, 0], [0, 0, 1], 0]
      - part: cnc/motor1-bearing-mount
        description: >-
          TODO(data): README.md lists this same file twice, as "Motor 1 Bearing
          Mount" (x1) and as "Link1 Bottom Metal" (x3). It is placed once here.
        location: [[0, 0, 0], [0, 0, 1], 0]
      - part: cnc/link1-metal-l
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% for i in range(4) %}
      - part: cnc/link1-metal-r
        name: link1-metal-r-{{ i + 1 }}
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% endfor %}
      - part: purchased/bearing-axk5578
        description: >-
          The joint 1 thrust bearing, which carries the weight of the arm. As on
          the DM variant, README.md does not order the two AS5578 washers this
          bearing normally sits between - see ../../PARTCAD.md.
        location: [[0, 0, 0], [0, 0, 1], 0]
      - part: purchased/pad-silicone
        description: >-
          The silicone pad. TODO(data): README.md does not say where it goes;
          under the base plate is the guess. The released RS CAD models four of
          these where the BOM orders one.
        location: [[0, 0, 0], [0, 0, 1], 0]

  # ---------------------------------------------------------------------------
  # Actuators and the hardware that mounts them
  # ---------------------------------------------------------------------------
  - name: joint-hardware
    description: >-
      The seven actuators and the spacers, extensions and cable fixings that mount them.
    location: [[0, 0, 0], [0, 0, 1], 0]
    links:
      # Joints 1-3 are the RS06, joints 4-7 the RS00, which is what the README's
      # quantities say; which physical joint each one is remains to be confirmed
      # against the CAD.
      {% for i in range(3) %}
      - part: purchased/actuator-rs06
        name: motor-{{ i + 1 }}
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% endfor %}
      {% for i in range(4) %}
      - part: purchased/actuator-rs00
        name: motor-{{ i + 4 }}
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% endfor %}
      {% for i in range(2) %}
      - part: cnc/rs06-front-extension
        name: rs06-front-extension-{{ i + 1 }}
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% endfor %}
      {% for i in range(2) %}
      - part: cnc/rs06-back-extension
        name: rs06-back-extension-{{ i + 1 }}
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% endfor %}
      - part: cnc/motor-back-spacer
        description: The motor 4 rear cable spacer.
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% for i in range(4) %}
      - part: cnc/motor-cable-clip
        name: motor-cable-clip-{{ i + 4 }}
        description: The motor 4 to 7 cable fixing.
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% endfor %}
      {% for i in range(3) %}
      - part: cnc/joint-disc
        name: joint-disc-{{ i + 1 }}
        description: The disc that covers a joint's screws.
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% endfor %}
      # The three 6803ZZ bearings. TODO(data): README.md gives the quantity and
      # not the joints they belong to, so they are grouped with the actuators
      # rather than placed in a joint.
      {% for i in range(3) %}
      - part: purchased/bearing-6803zz
        name: bearing-6803zz-{{ i + 1 }}
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% endfor %}

  # ---------------------------------------------------------------------------
  # Upper arm
  # ---------------------------------------------------------------------------
  - name: upper-arm
    description: >-
      The upper arm - link 2 with its filler, cover and handle, the upper limits, and the link to the lower arm.
    location: [[0, 0, 0], [0, 0, 1], 0]
    links:
      {% for i in range(2) %}
      - part: cnc/link2
        name: link2-{{ 'l' if i == 0 else 'r' }}
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% endfor %}
      - part: printed/upper-arm-filler-l
        location: [[0, 0, 0], [0, 0, 1], 0]
      - part: printed/upper-arm-filler-r
        location: [[0, 0, 0], [0, 0, 1], 0]
      - part: printed/arm-handle
        location: [[0, 0, 0], [0, 0, 1], 0]
      - part: cnc/upper-limit-l
        location: [[0, 0, 0], [0, 0, 1], 0]
      - part: cnc/upper-limit-r
        location: [[0, 0, 0], [0, 0, 1], 0]
      - part: cnc/lower-upper-link-l
        location: [[0, 0, 0], [0, 0, 1], 0]
      - part: cnc/lower-upper-link-r
        location: [[0, 0, 0], [0, 0, 1], 0]
      # The centre fillers and the covers are one part each, used twice: once on
      # the upper arm and once on the lower one.
      - part: printed/arm-filler-m
        name: upper-arm-filler-m
        location: [[0, 0, 0], [0, 0, 1], 0]
      - part: printed/arm-cover
        name: upper-arm-cover
        location: [[0, 0, 0], [0, 0, 1], 0]

  # ---------------------------------------------------------------------------
  # Lower arm
  # ---------------------------------------------------------------------------
  - name: lower-arm
    description: >-
      The lower arm - link 3 with its fillers and cover, and the connector between its two halves.
    location: [[0, 0, 0], [0, 0, 1], 0]
    links:
      - part: cnc/link3-metal-l
        location: [[0, 0, 0], [0, 0, 1], 0]
      - part: cnc/link3-metal-r
        location: [[0, 0, 0], [0, 0, 1], 0]
      - part: cnc/link3-connector
        location: [[0, 0, 0], [0, 0, 1], 0]
      - part: printed/lower-arm-filler-l
        location: [[0, 0, 0], [0, 0, 1], 0]
      - part: printed/lower-arm-filler-r
        location: [[0, 0, 0], [0, 0, 1], 0]
      - part: printed/arm-filler-m
        name: lower-arm-filler-m
        location: [[0, 0, 0], [0, 0, 1], 0]
      - part: printed/arm-cover
        name: lower-arm-cover
        location: [[0, 0, 0], [0, 0, 1], 0]

  # ---------------------------------------------------------------------------
  # Wrist
  # ---------------------------------------------------------------------------
  - name: wrist
    description: >-
      The wrist - links 4-5 and 5, and the two connectors that carry the gripper motor.
    location: [[0, 0, 0], [0, 0, 1], 0]
    links:
      - part: cnc/link4-5-l
        location: [[0, 0, 0], [0, 0, 1], 0]
      - part: cnc/link4-5-r
        location: [[0, 0, 0], [0, 0, 1], 0]
      - part: cnc/link5
        location: [[0, 0, 0], [0, 0, 1], 0]
      - part: cnc/wrist-connector-a
        location: [[0, 0, 0], [0, 0, 1], 0]
      - part: cnc/wrist-connector-b
        location: [[0, 0, 0], [0, 0, 1], 0]

  # ---------------------------------------------------------------------------
  # Gripper
  # ---------------------------------------------------------------------------
  - name: gripper
    description: >-
      The gripper - the rack and pinion slide on its linear rail, the two fingers, and what holds them.
    location: [[0, 0, 0], [0, 0, 1], 0]
    links:
      - part: cnc/gripper-connector-a
        location: [[0, 0, 0], [0, 0, 1], 0]
      - part: cnc/slider-bracket
        location: [[0, 0, 0], [0, 0, 1], 0]
      - part: printed/rail-bracket
        location: [[0, 0, 0], [0, 0, 1], 0]
      - part: printed/gripper-limit
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% for i in range(2) %}
      - part: cnc/slider-extension
        name: slider-extension-{{ i + 1 }}
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% endfor %}
      {% for i in range(2) %}
      - part: cnc/rack
        name: rack-{{ i + 1 }}
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% endfor %}
      {% for i in range(2) %}
      - part: printed/finger
        name: finger-{{ i + 1 }}
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% endfor %}
      - part: purchased/rail-mgn9-170
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% for i in range(2) %}
      - part: purchased/carriage-mgn9
        name: carriage-mgn9-{{ i + 1 }}
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% endfor %}
      # TODO(data): the module-1, 16-tooth gear that drives the racks is bought
      # rather than made and has no envelope yet - see ../../PARTCAD.md.

  # ---------------------------------------------------------------------------
  # Wiring, optional
  # ---------------------------------------------------------------------------
  - name: wiring
    description: >-
      The printed clips that stop the motor 1 harness from being dragged. Optional, and recommended by README.md.
    location: [[0, 0, 0], [0, 0, 1], 0]
    links:
      {% for i in range(2) %}
      - part: printed/motor1-harness-clip
        name: motor1-harness-clip-{{ i + 1 }}
        location: [[0, 0, 0], [0, 0, 1], 0]
      {% endfor %}
